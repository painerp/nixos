{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": [
      "* * * * 0"
    ],
    "updateNotScheduled": false
  },
  "nix": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchManagers": [
        "nix"
      ],
      "enabled": false,
      "matchPackageNames": [
        "/nixos-private/",
        "/git\\+ssh://.*nixos-private/"
      ]
    },
    {
      "matchPackageNames": [
        "docker.io/iiidev/iii"
      ],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/variants/.+\\.nix$/"
      ],
      "matchStrings": [
        "agentmemory\\s*=\\s*\\{[^}]*?version\\s*=\\s*\"(?<currentValue>[^\"]+)\"[^}]*?\\}"
      ],
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm",
      "depNameTemplate": "@agentmemory/agentmemory"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/variants/.+\\.nix$/"
      ],
      "matchStrings": [
        "adguardhome\\s*=\\s*\\{[^}]*?\\sversion\\s*=\\s*\"(?<currentValue>[^\"]+)\"[^}]*?\\}"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver",
      "depNameTemplate": "docker.io/adguard/adguardhome"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/variants/.+\\.nix$/"
      ],
      "matchStrings": [
        "authentik\\s*=\\s*\\{[^}]*?\\sversion\\s*=\\s*\"(?<currentValue>[^\"]+)\"[^}]*?\\}"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver",
      "depNameTemplate": "ghcr.io/goauthentik/proxy"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/variants/.+\\.nix$/"
      ],
      "matchStrings": [
        "dawarich\\s*=\\s*\\{[^}]*?\\sversion\\s*=\\s*\"(?<currentValue>[^\"]+)\"[^}]*?\\}"
      ],
      "datasourceTemplate": "docker",
